# =============================================================================
# Machine Learning — Large Generated Artifacts
# (These are recreated automatically by running main.py)
# =============================================================================

# Trained SVM model
models/image_classifier.joblib

# Cached HOG feature files (very large — regenerated on first run)
models/train_hog.joblib
models/test_hog.joblib

# Keep the models/ folder itself tracked (do not ignore the directory)
!models/.gitkeep

